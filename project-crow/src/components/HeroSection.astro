---
// src/components/HeroSection.astro
---
<section id="home" class="h-screen flex items-center">
  <div class="container mx-auto grid grid-cols-1 md:grid-cols-2 gap-8 items-center px-4">
    <div class="text-center md:text-left">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight animate-on-scroll">
        Building High-Performance 
        <span class="bg-clip-text text-transparent bg-gradient-to-r from-brand-primary via-white to-brand-primary bg-[length:200%_auto] animate-text-shimmer">
          Fintech Platforms.
        </span>
      </h1>
      <p class="mt-4 text-lg text-brand-text-secondary animate-on-scroll delay-200">
        Hi, I'm Hangga. I’m a Technical Product Manager bridging the gap between complex technical infrastructure and seamless user experiences.
      </p>
      <a href="#playground" class="mt-8 inline-block bg-brand-primary hover:bg-brand-secondary text-white font-bold py-3 px-6 rounded-lg transition-colors animate-on-scroll delay-300">
        View My Work
      </a>
    </div>

    <div class="flex items-center justify-center animate-on-scroll delay-200">
        <img src="/Avatar.jpg" alt="Avatar Annur Hangga Prihadi" class="w-48 h-48 md:w-72 md:h-72 rounded-full shadow-lg object-cover" />
    </div>
  </div>
</section>