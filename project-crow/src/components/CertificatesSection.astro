---
// src/components/CertificatesSection.astro (HORIZONTAL SCROLL LAYOUT)
import { certificates } from '../data/certificates.js';
---
<section id="certificates" class="py-24 bg-brand-surface dark:bg-brand-surface border-t border-brand-outline/30">
  <div class="container mx-auto px-4 max-w-7xl">
    <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-4 animate-on-scroll">
      <div>
        <h2 class="text-3xl md:text-4xl font-bold mb-2">Certifications</h2>
        <p class="text-brand-text-secondary dark:text-brand-text-secondary">Deep technical proficiency enabling precise architectural oversight and feasibility assessment.</p>
      </div>
      
      <!-- Custom Scroll Controls (Optional visual cue) -->
      <div class="hidden md:flex gap-2">
        <button id="scroll-left" class="p-2 rounded-full border border-brand-outline hover:bg-brand-background transition-colors text-brand-text-primary">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
        </button>
        <button id="scroll-right" class="p-2 rounded-full border border-brand-outline hover:bg-brand-background transition-colors text-brand-text-primary">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </button>
      </div>
    </div>
  
    <!-- Horizontal Scroll Container -->
    <div 
      id="cert-container"
      class="flex overflow-x-auto gap-6 pb-8 snap-x snap-mandatory scroll-smooth hide-scrollbar animate-on-scroll delay-200"
    >
      {certificates.map(cert => (
        <a 
          href={cert.credentialUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="flex-none w-[280px] md:w-[320px] snap-start group"
        >
          <div class="bg-brand-background dark:bg-brand-background rounded-xl border border-brand-outline dark:border-brand-outline p-4 h-full hover:border-brand-primary transition-all duration-300 hover:shadow-md flex flex-col">
            <div class="aspect-video w-full bg-white dark:bg-gray-100 rounded-lg overflow-hidden mb-4 p-4 flex items-center justify-center relative">
              <img 
                src={cert.imgSrc} 
                alt={cert.title} 
                class="w-full h-full object-contain transition-transform duration-500 group-hover:scale-105" 
              />
            </div>
            <div class="mt-auto">
              <h3 class="text-sm font-bold text-brand-text-primary dark:text-brand-text-primary leading-tight group-hover:text-brand-primary transition-colors">
                {cert.title}
              </h3>
              <p class="text-xs text-brand-text-secondary mt-2 flex items-center gap-1">
                View Credential <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
              </p>
            </div>
          </div>
        </a>
      ))}
      
      <!-- Spacer at the end for better scrolling feel -->
      <div class="flex-none w-4"></div>
    </div>
  </div>
</section>

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  const container = document.getElementById('cert-container');
  const leftBtn = document.getElementById('scroll-left');
  const rightBtn = document.getElementById('scroll-right');

  if (container && leftBtn && rightBtn) {
    leftBtn.addEventListener('click', () => {
      container.scrollBy({ left: -320, behavior: 'smooth' });
    });

    rightBtn.addEventListener('click', () => {
      container.scrollBy({ left: 320, behavior: 'smooth' });
    });
  }
</script>
