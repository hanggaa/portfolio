---
// src/components/AboutSection.astro
import { experiences } from '../data/experiences.js';
---
<section id="about" class="py-24 bg-brand-background dark:bg-brand-bg px-4 overflow-hidden">
  <div class="container mx-auto max-w-6xl">
    <div class="text-center mb-16 animate-on-scroll">
      <h2 class="text-4xl md:text-5xl font-bold mb-4">The Architect Behind The Product</h2>
      <p class="text-lg text-brand-text-secondary dark:text-brand-text-secondary max-w-2xl mx-auto">
        Lead Product Manager & Technical Strategist bridging the gap between complex business requirements and scalable technical execution.
      </p>
    </div>

    <!-- Bio & Stats Section -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-20 items-start">
      <!-- Left: Who I Am -->
      <div class="space-y-6 animate-on-scroll delay-200">
        <h3 class="text-3xl font-bold text-brand-primary dark:text-brand-primary">Who I Am</h3>
        <div class="prose dark:prose-invert max-w-none text-brand-text-secondary dark:text-brand-text-secondary leading-relaxed space-y-4">
          <p>
            I am a <strong>Product Lead</strong> with a strong background in building data-driven platforms from <strong>0-to-1</strong>. My expertise lies in translating complex market requirements into scalable technical roadmaps (APIs/Microservices) and leading cross-functional squads to deliver high-volume transaction engines.
          </p>
          <p>
            Currently at <strong>NoaSight</strong>, I architected and launched a high-performance event resolution platform that scaled to <strong>10,000+ transactions</strong> and acquired <strong>300+ active users</strong> within 6 months. I combine technical fluency in System Architecture and Cloud Infrastructure (GCP) with rigorous <strong>SQL & Python</strong> analysis to build products that are not just functional, but profitable and user-centric.
          </p>
          <p>
            Previously, I managed a <strong>$1M+ corporate asset portfolio</strong> at Cloudsolutely, leveraging data science to drive a <strong>68% YoY growth</strong>. Whether it's designing institutional-grade security protocols or pioneering Enterprise Architecture curricula, I focus on execution, scalability, and impact.
          </p>
        </div>

        <!-- Skills Tags -->
        <div class="pt-4">
          <h4 class="text-sm font-bold uppercase tracking-wider text-brand-text-primary dark:text-brand-text-primary mb-3">Core Competencies</h4>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 bg-brand-surface border border-brand-outline rounded-full text-sm font-medium hover:border-brand-primary transition-colors cursor-default">Product Lifecycle (PLM)</span>
            <span class="px-3 py-1 bg-brand-surface border border-brand-outline rounded-full text-sm font-medium hover:border-brand-primary transition-colors cursor-default">Go-to-Market Strategy</span>
            <span class="px-3 py-1 bg-brand-surface border border-brand-outline rounded-full text-sm font-medium hover:border-brand-primary transition-colors cursor-default">Agile & Scrum</span>
            <span class="px-3 py-1 bg-brand-surface border border-brand-outline rounded-full text-sm font-medium hover:border-brand-primary transition-colors cursor-default">SQL & Data Analytics</span>
            <span class="px-3 py-1 bg-brand-surface border border-brand-outline rounded-full text-sm font-medium hover:border-brand-primary transition-colors cursor-default">System Architecture</span>
            <span class="px-3 py-1 bg-brand-surface border border-brand-outline rounded-full text-sm font-medium hover:border-brand-primary transition-colors cursor-default">Financial Modeling</span>
            <span class="px-3 py-1 bg-brand-surface border border-brand-outline rounded-full text-sm font-medium hover:border-brand-primary transition-colors cursor-default">Risk Management</span>
            <span class="px-3 py-1 bg-brand-surface border border-brand-outline rounded-full text-sm font-medium hover:border-brand-primary transition-colors cursor-default">Stakeholder Management</span>
            <span class="px-3 py-1 bg-brand-surface border border-brand-outline rounded-full text-sm font-medium hover:border-brand-primary transition-colors cursor-default">Product Vision & Roadmap</span>
            <span class="px-3 py-1 bg-brand-surface border border-brand-outline rounded-full text-sm font-medium hover:border-brand-primary transition-colors cursor-default">User Stories & Requirements</span>
            <span class="px-3 py-1 bg-brand-surface border border-brand-outline rounded-full text-sm font-medium hover:border-brand-primary transition-colors cursor-default">A/B Testing & Experimentation</span>
            <span class="px-3 py-1 bg-brand-surface border border-brand-outline rounded-full text-sm font-medium hover:border-brand-primary transition-colors cursor-default">Competitive Analysis</span>
          </div>
        </div>
      </div>

      <!-- Right: Key Metrics Grid -->
      <div class="grid grid-cols-2 gap-4">
        <div class="p-6 bg-brand-surface dark:bg-brand-surface rounded-2xl border border-brand-outline hover:border-brand-primary transition-all duration-300 transform hover:-translate-y-1 shadow-sm animate-on-scroll delay-100">
          <div class="text-4xl font-bold text-brand-primary dark:text-brand-primary mb-2 flex items-baseline">
            <span class="counter" data-target="42" data-prefix="$" data-suffix="K+">0</span>
          </div>
          <div class="text-sm font-semibold text-brand-text-primary dark:text-brand-text-primary">Monthly Volume</div>
          <p class="text-xs text-brand-text-secondary dark:text-brand-text-secondary mt-1">Achieved within 6 months of beta launch</p>
        </div>
        <div class="p-6 bg-brand-surface dark:bg-brand-surface rounded-2xl border border-brand-outline hover:border-brand-primary transition-all duration-300 transform hover:-translate-y-1 shadow-sm animate-on-scroll delay-200">
          <div class="text-4xl font-bold text-brand-primary dark:text-brand-primary mb-2 flex items-baseline">
            <span class="counter" data-target="300" data-suffix="+">0</span>
          </div>
          <div class="text-sm font-semibold text-brand-text-primary dark:text-brand-text-primary">Active Users</div>
          <p class="text-xs text-brand-text-secondary dark:text-brand-text-secondary mt-1">Acquired through organic GTM strategy</p>
        </div>
        <div class="p-6 bg-brand-surface dark:bg-brand-surface rounded-2xl border border-brand-outline hover:border-brand-primary transition-all duration-300 transform hover:-translate-y-1 shadow-sm animate-on-scroll delay-300">
          <div class="text-4xl font-bold text-brand-primary dark:text-brand-primary mb-2 flex items-baseline">
            <span class="counter" data-target="68" data-suffix="%">0</span>
          </div>
          <div class="text-sm font-semibold text-brand-text-primary dark:text-brand-text-primary">YoY Portfolio Growth</div>
          <p class="text-xs text-brand-text-secondary dark:text-brand-text-secondary mt-1">Driven by data-driven asset allocation</p>
        </div>
        <div class="p-6 bg-brand-surface dark:bg-brand-surface rounded-2xl border border-brand-outline hover:border-brand-primary transition-all duration-300 transform hover:-translate-y-1 shadow-sm animate-on-scroll delay-400">
          <div class="text-4xl font-bold text-brand-primary dark:text-brand-primary mb-2">0-to-1</div>
          <div class="text-sm font-semibold text-brand-text-primary dark:text-brand-text-primary">Product Lifecycle</div>
          <p class="text-xs text-brand-text-secondary dark:text-brand-text-secondary mt-1">From R&D to successful market launch</p>
        </div>
      </div>
    </div>

    <!-- Timeline Section -->
    <div class="max-w-4xl mx-auto">
      <h3 class="text-3xl font-bold text-center mb-12 animate-on-scroll">My Professional Journey</h3>
      
      <div class="relative pl-8 md:pl-0">
        <!-- Vertical Line (Centered on MD, Left on Mobile) -->
        <div class="absolute left-8 md:left-1/2 top-0 bottom-0 w-0.5 bg-brand-outline dark:bg-brand-outline transform -translate-x-1/2"></div>

        {experiences.map((exp, index) => (
          <div class={`mb-12 relative flex flex-col md:flex-row items-center experience-item group cursor-pointer animate-on-scroll ${index % 2 === 0 ? 'md:flex-row-reverse' : ''}`} data-experience-id={exp.id}>
            
            <!-- Timeline Dot -->
            <div class="absolute left-8 md:left-1/2 w-5 h-5 bg-brand-primary rounded-full border-4 border-brand-background dark:border-brand-bg transform -translate-x-1/2 z-10 transition-transform duration-300 group-hover:scale-125"></div>
            
            <!-- Content Card -->
            <div class={`w-full md:w-5/12 pl-12 md:pl-0 ${index % 2 === 0 ? 'md:pl-12' : 'md:pr-12 text-right'}`}>
              <div class="p-6 bg-brand-surface dark:bg-brand-surface rounded-xl border border-brand-outline hover:border-brand-primary transition-all duration-300 shadow-sm hover:shadow-md transform group-hover:-translate-y-1">
                <div class={`flex flex-col gap-2 ${index % 2 === 0 ? 'items-start' : 'md:items-end items-start'}`}>
                  <div class="flex items-center gap-3">
                    {exp.companyImage && (
                      <img src={exp.companyImage} alt={exp.company} class="w-10 h-10 rounded-lg object-cover border border-brand-outline md:hidden" />
                    )}
                    <h4 class="text-xl font-bold text-brand-text-primary dark:text-brand-text-primary group-hover:text-brand-primary transition-colors">{exp.title}</h4>
                  </div>
                  <div class="text-sm font-medium text-brand-text-secondary dark:text-brand-text-secondary">
                    {exp.company}
                  </div>
                  <div class="text-xs text-brand-text-secondary/70 uppercase tracking-wide">
                    {exp.duration}
                  </div>
                  <p class="mt-3 text-sm text-brand-text-secondary dark:text-brand-text-secondary leading-relaxed">
                    {exp.summary}
                  </p>
                  
                  {/* Visual Indicator for Click */}
                  <div class="mt-4 text-xs font-semibold text-brand-primary flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                    View Details <span class="text-lg">→</span>
                  </div>
                </div>
              </div>
            </div>
            
            <!-- Empty Space for the other side -->
            <div class="hidden md:block md:w-5/12"></div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Experience Modal (unchanged script logic, just styling) -->
  <div id="experience-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm hidden z-50 items-center justify-center p-4">
    <div class="bg-brand-background dark:bg-brand-surface rounded-2xl max-w-4xl w-full max-h-[90vh] overflow-y-auto border border-brand-outline shadow-2xl relative">
      <div class="p-8">
        <button id="close-modal" class="absolute top-6 right-6 text-brand-text-secondary hover:text-brand-primary transition-colors">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>

        <div class="flex flex-col md:flex-row items-start gap-6 mb-8">
          <img id="modal-company-image" src="" alt="Company" class="w-24 h-24 rounded-xl object-cover border-2 border-brand-outline shadow-md">
          <div>
            <h3 id="modal-title" class="text-3xl font-bold text-brand-text-primary mb-2"></h3>
            <div class="flex flex-col gap-1">
              <p id="modal-company" class="text-xl font-medium text-brand-primary"></p>
              <div class="flex items-center gap-4 text-sm text-brand-text-secondary">
                <span id="modal-duration"></span>
                <span>•</span>
                <span id="modal-location"></span>
              </div>
            </div>
          </div>
        </div>

        <div id="modal-content" class="space-y-8">
          <!-- Content populated by JS -->
        </div>

        <div id="modal-media" class="mt-10 pt-8 border-t border-brand-outline">
          <!-- Media populated by JS -->
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ experiences }}>
  // --- COUNTER ANIMATION LOGIC ---
  const counters = document.querySelectorAll('.counter');
  
  const animateCounter = (counter) => {
    const target = +counter.getAttribute('data-target');
    const prefix = counter.getAttribute('data-prefix') || '';
    const suffix = counter.getAttribute('data-suffix') || '';
    const duration = 2000; // 2 seconds
    const increment = target / (duration / 16); // 60fps

    let current = 0;

    const updateCount = () => {
      current += increment;
      if (current < target) {
        counter.innerText = prefix + Math.ceil(current) + suffix;
        requestAnimationFrame(updateCount);
      } else {
        counter.innerText = prefix + target + suffix;
      }
    };

    updateCount();
  };

  // Trigger animation when visible
  const counterObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const counter = entry.target;
        animateCounter(counter);
        counterObserver.unobserve(counter);
      }
    });
  }, { threshold: 0.5 });

  counters.forEach(counter => {
    counterObserver.observe(counter);
  });


  // --- EXPERIENCE MODAL LOGIC (UNCHANGED) ---
  const modal = document.getElementById('experience-modal');
  const closeBtn = document.getElementById('close-modal');
  const experienceItems = document.querySelectorAll('.experience-item');

  function openModal(experienceId) {
    const exp = experiences.find(e => e.id === experienceId);
    if (!exp) return;

    // Populate modal header
    document.getElementById('modal-title').textContent = exp.title;
    document.getElementById('modal-company').textContent = exp.company;
    document.getElementById('modal-duration').textContent = exp.duration;
    document.getElementById('modal-location').textContent = exp.location;
    document.getElementById('modal-company-image').src = exp.companyImage;

    // Build detailed content
    let content = `<div class="p-4 bg-brand-surface/50 rounded-lg border border-brand-outline mb-8"><p class="text-lg leading-relaxed italic text-brand-text-primary">"${exp.summary}"</p></div>`;

    // Dynamically add all detail sections
    Object.keys(exp.details).forEach(sectionKey => {
      const sectionTitle = sectionKey
        .replace(/([A-Z])/g, ' $1')
        .trim()
        .toUpperCase();
      
      content += `
        <div class="mb-6">
          <h4 class="flex items-center gap-2 text-lg font-bold text-brand-primary mb-4 border-b border-brand-outline pb-2">
            ${sectionTitle}
          </h4>
          <ul class="space-y-3">
      `;
      
      exp.details[sectionKey].forEach(item => {
        content += `<li class="flex items-start gap-3 text-brand-text-secondary leading-relaxed">
          <span class="mt-1.5 w-1.5 h-1.5 bg-brand-primary rounded-full flex-shrink-0"></span>
          <span>${item}</span>
        </li>`;
      });
      content += `</ul></div>`;
    });

    document.getElementById('modal-content').innerHTML = content;

    // Build media section
    let mediaContent = '';
    if (exp.media && exp.media.length > 0) {
      mediaContent += `<h4 class="text-lg font-bold text-brand-primary mb-6">Work Samples & Media</h4>`;
      mediaContent += `<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">`;
      exp.media.forEach(item => {
        mediaContent += `
          <a href="${item.url}" target="_blank" rel="noopener noreferrer" class="group block h-full">
            <div class="relative h-full overflow-hidden rounded-xl border border-brand-outline bg-brand-surface hover:border-brand-primary transition-all duration-300 flex flex-col">
              <div class="h-32 overflow-hidden">
                <img src="${item.companyimage}" alt="${item.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              </div>
              <div class="p-3 flex-1 flex flex-col justify-between">
                <p class="text-sm font-semibold text-brand-text-primary group-hover:text-brand-primary transition-colors line-clamp-2">${item.title}</p>
                <div class="mt-2 text-xs text-brand-text-secondary flex items-center gap-1">
                  View Resource <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                </div>
              </div>
            </div>
          </a>
        `;
      });
      mediaContent += `</div>`;
    }

    document.getElementById('modal-media').innerHTML = mediaContent;

    // Show modal
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = 'auto';
  }

  // Event listeners
  experienceItems.forEach(item => {
    item.addEventListener('click', () => {
      const experienceId = item.dataset.experienceId;
      openModal(experienceId);
    });
  });

  closeBtn.addEventListener('click', closeModal);

  modal.addEventListener('click', (e) => {
    if (e.target === modal) {
      closeModal();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });
</script>
